{
  "openmemory": {
    "custom_instructions": null
  },
  "mem0": {
    "llm": {
      "provider": "ollama",
      "config": {
        "model": "llama3.2:3b",
        "temperature": 0.1,
        "max_tokens": 2000,
        "ollama_base_url": "http://host.docker.internal:11434"
      }
    },
    "embedder": {
      "provider": "ollama",
      "config": {
        "model": "nomic-embed-text",
        "ollama_base_url": "http://host.docker.internal:11434"
      }
    },
    "vector_store": {
      "provider": "qdrant",
      "config": {
        "host": "mem0_store",
        "port": 6333,
        "collection_name": "openmemory",
        "embedding_model_dims": 768
      }
    }
  }
}
