# Copier ce fichier en .env :   cp .env.example .env
# (aucun secret réel ici — tout est local)

# --- Identité ---
# user_id auquel sont rattachées tes mémoires
USER=pascal

# Clé d'API locale exigée par OpenMemory. N'importe quelle valeur.
# Elle reste sur ta machine, n'est envoyée nulle part.
API_KEY=local-dev-key

# --- LLM : Ollama natif sur ton Mac ---
# Petit modèle suffisant pour valider le pipeline (étape 3).
# Pour plus de qualité plus tard (16 Go+ de RAM) : llama3.1:8b
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Embeddings : Ollama natif ---
# nomic-embed-text = 768 dimensions (voir README, point important)
EMBEDDER_PROVIDER=ollama
EMBEDDER_MODEL=nomic-embed-text

# --- Stockage vectoriel : Qdrant (dans Docker) ---
QDRANT_HOST=mem0_store
QDRANT_PORT=6333

# --- Contournement du client OpenAI codé en dur (catégorisation) ---
# OpenMemory instancie un client OpenAI en dur (modèle gpt-4o-mini) au
# démarrage ET pour catégoriser les mémoires (bug connu mem0 #3439).
# On le détourne vers Ollama (API compatible OpenAI sur /v1) → tout reste local.
# Prérequis : un alias Ollama nommé "gpt-4o-mini" (créé par pull-models.sh).
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# --- UI ---
NEXT_PUBLIC_API_URL=http://localhost:8765
NEXT_PUBLIC_USER_ID=pascal

# --- Phase 2 : accès web (OAuth Google + HTTPS) ---
# URL publique HTTPS (doit matcher le DNS et l'URI de redirection Google)
MCP_BASE_URL=https://mem0.autrepascal.ca
# Identifiants OAuth créés dans la console Google Cloud (à remplir sur la VM)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mot de passe du visualiseur web privé (/viewer) — choisis-le
VIEWER_PASSWORD=
