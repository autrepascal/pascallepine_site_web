# Copier ce fichier en .env :   cp .env.example .env
# (aucun secret réel ici — tout est local)

# --- Identité ---
# user_id auquel sont rattachées tes mémoires
USER=pascal

# Clé d'API locale exigée par OpenMemory. N'importe quelle valeur.
# Elle reste sur ta machine, n'est envoyée nulle part.
API_KEY=local-dev-key

# --- LLM : Ollama natif sur ton Mac ---
# Petit modèle suffisant pour valider le pipeline (étape 3).
# Pour plus de qualité plus tard (16 Go+ de RAM) : llama3.1:8b
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Embeddings : Ollama natif ---
# nomic-embed-text = 768 dimensions (voir README, point important)
EMBEDDER_PROVIDER=ollama
EMBEDDER_MODEL=nomic-embed-text

# --- Stockage vectoriel : Qdrant (dans Docker) ---
QDRANT_HOST=mem0_store
QDRANT_PORT=6333

# --- UI ---
NEXT_PUBLIC_API_URL=http://localhost:8765
NEXT_PUBLIC_USER_ID=pascal
